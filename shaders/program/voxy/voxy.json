    "blending": {
        "-1": "SRC_ALPHA ONE_MINUS_SRC_ALPHA SRC_ALPHA ONE_MINUS_SRC_ALPHA"
    },
    "uniforms": [
        "gbufferModelView",
        "gbufferModelViewInverse",
        "vxProjInv",
        "viewWidth",
        "viewHeight",
        "cameraPosition",
        "sunPosition",
        "shadowLightPosition",
        "worldTime",
        "rainStrength",
        "isEyeInWater",
        "screenBrightness",
        "eyeBrightnessSmooth",
        "fogColor",
        "skyColor",
        "fogStart",
        "fogEnd",
        "shadowModelView",
        "shadowProjection"
    ],
    "samplers": {
        "lightmap": "sampler2D",
        "shadowtex1": "sampler2D"
    }
