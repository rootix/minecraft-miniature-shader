// Shared prelude for the Voxy LoD patches (voxy_opaque.glsl and
// voxy_translucent.glsl in this folder, included from the per-dimension
// wrapper files in the world folders).
//
// These sources are compiled by Voxy itself against `#version 460 core`:
//  - the uniforms listed in voxy.json arrive as members of a std140 UBO
//    block generated by Voxy, so they must not be redeclared here;
//  - the samplers listed in voxy.json are declared by Voxy as well;
//  - core profile GLSL only: use texture() instead of texture2D(), and no
//    legacy gl_* attributes are available.
// The Iris preprocessor still runs over these files, so the shader settings
// from shader.h and the environment macros (MC_VERSION, VOXY, ...) can be
// used exactly like in the vanilla programs.

#include "/shader.h"

#include "/common/math.glsl"

// Local replacements for the helpers in common/transformations.glsl, whose
// uniform declarations would clash with the UBO provided by Voxy.

vec3 feet2world(vec3 feet) {
   return feet + cameraPosition;
}

vec3 world2feet(vec3 world) {
   return world - cameraPosition;
}

vec3 view2feet(vec3 view) {
   return (gbufferModelViewInverse * vec4(view, 1.0)).xyz;
}

vec3 clip2screen(vec4 clip) {
   return 0.5 * (clip.xyz / clip.w) + 0.5;
}

// as declared by the vanilla programs before including getTorchColor.fsh;
// the plain uniform is never set here, so it reads as 0, which is correct:
// held light can never reach LoD terrain anyway
#if HAND_DYNAMIC_LIGHTING == 0
   uniform int heldBlockLightValue;
#elif HAND_DYNAMIC_LIGHTING == 1
   #define heldBlockLightValue 14
#endif

#include "/common/getTorchColor.fsh"
#include "/common/getLightColor.vsh"

#ifdef ENABLE_SHADOWS
   #include "/common/getShadowDistortion.glsl"

   // Core profile version of common/getLightStrength.fsh (which Voxy cannot
   // include here since it still uses texture2D()).
   float getLightStrength(float diffuse, float skyLight, vec3 feetPos) {
      // reduce diffuse with sky light
      diffuse *= rescale(skyLight, 0.3137, 0.6235);

      #if SHADOW_PIXEL > 0
         vec3 pos = world2feet(bandify(feet2world(feetPos), SHADOW_PIXEL));
      #else
         vec3 pos = feetPos;
      #endif

      float posDistance = squaredLength(pos);
      vec4 shadowView   = shadowModelView * vec4(pos, 1.0);
      vec4 shadowClip   = shadowProjection * shadowView;

      shadowClip.xyz = getShadowDistortion(shadowClip.xyz);

      vec3 shadowUV = clip2screen(shadowClip);

      if (posDistance < SHADOW_MAX_DIST_SQUARED &&
         diffuse    > 0.0 && shadowUV.z < 1.0 &&
         shadowUV.s > 0.0 && shadowUV.s < 1.0 &&
         shadowUV.t > 0.0 && shadowUV.t < 1.0)
      {
         float shadowFade  = 1.0 - posDistance * INV_SHADOW_MAX_DIST_SQUARED;
         float shadowDepth = texture(shadowtex1, shadowUV.st).x;

         return diffuse * (1.0 - shadowFade * clamp(3.0*(shadowDepth - shadowUV.z) / shadowProjection[2].z, 0.0, 1.0));
      }

      return diffuse;
   }
#endif

// Core profile version of common/getAmbientColor.glsl.

vec4 getAmbientColor(float skyLight, float sunHeight) {
   vec4 ambient = texture(lightmap, vec2(AMBIENT_UV.s, skyLight));

   #ifdef OVERWORLD
      float boost = (((0.8494 * ambient.g + 0.9687) * ambient.g - 5.238) * ambient.g + 3.711) * ambient.g - 0.2864;

      boost = max(0.0, boost);

      ambient.rgb = mix(
         min(vec3(1.0), ambient.rgb + vec3(boost) * clamp(0.2*sunHeight, 0.0, 1.0)),
         ambient.rgb,
         screenBrightness
      );
   #endif

   return ambient;
}

// Version of common/getFogMix.vsh with the far plane fixed at Voxy's
// 48000 blocks, matching the #ifdef VOXY branch the vanilla programs use,
// so the vanilla-to-LoD boundary stays seamless.

float calcFogMix(vec3 feetPos, float fogStartMult) {
   float len = length(feetPos);
   float cylinderLen = max(length(feetPos.xz), abs(feetPos.y));

   return max(
      rescale(len, fogStartMult * fogStart, fogEnd),
      rescale(cylinderLen, fogStartMult * (48000.0 - clamp(0.1 * 48000.0, 4.0, 64.0)), 48000.0)
   );
}

float getFogMix(vec3 feetPos) {
   #ifndef ENABLE_FOG
      if (fogEnd >= 48000.0) {
         return 0.0;
      }
   #endif

   if (fogEnd < 48000.0) {
      // a fog effect (like blindness) is active
      return calcFogMix(feetPos, 1.0);
   }

   #ifdef OVERWORLD
      float x = worldTime * NORMALIZE_TIME;

      x = clamp(25.0*(x < MIDNIGHT ? SUNSET - x : x - SUNRISE) + 0.3,
               OVERWORLD_FOG_MIN,
               OVERWORLD_FOG_MAX);

      x = min(x, 1.0 - rainStrength);
   #else
      float x = 1.0;
   #endif

   return calcFogMix(feetPos, x);
}

// Version of common/getFogColor.vsh.

vec3 getFogColor(float fogMix, vec3 feetPos) {
   #ifdef OVERWORLD
      return mix(fogColor, skyColor, fogMix * clamp(0.006*feetPos.y, 0.0, 1.0));
   #else
      return fogColor;
   #endif
}
